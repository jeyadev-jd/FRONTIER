# FRONTIER Environment Configuration
# Copy to .env and fill in your values. NEVER commit .env.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
SECRET_KEY=change-this-to-a-random-secret-key

# Database
DATABASE_URL=sqlite+aiosqlite:///./frontier.db
# For PostgreSQL: postgresql+asyncpg://user:pass@localhost/frontier

# Local LLM Provider: "ollama" or "lmstudio"
LLM_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# LM Studio
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# LLM Generation Settings
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_CONTEXT_LENGTH=8192

# Discord Bot
DISCORD_BOT_TOKEN=your-bot-token-here
DISCORD_GUILD_ID=your-guild-id-here
DISCORD_APPLICATION_ID=your-application-id-here

# X / Twitter API (optional, Phase 4)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_BEARER_TOKEN=

# Web Search (optional, Phase 2)
SEARCH_PROVIDER=duckduckgo
SERPAPI_KEY=

# Content Settings
MIN_RELEVANCE_SCORE=0.70
MIN_CREDIBILITY_SCORE=0.65
MAX_POSTS_PER_DAY=20
DEFAULT_AUTO_PUBLISH=false

# Dashboard
DASHBOARD_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
